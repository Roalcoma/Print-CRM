# ── Servidor ─────────────────────────────────────────────────────────────────
# IP o dominio del servidor (sin https://, sin puerto)
SERVER_HOST=192.168.0.123

# URL pública completa del CRM (la que ven los usuarios / webhooks externos)
PUBLIC_URL=http://192.168.0.123:3100

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=cambia_esto_por_una_password_segura

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
AGENCY_JWT_SECRET=otro_secreto_para_la_agencia

# ── Evolution API (WhatsApp) ──────────────────────────────────────────────────
# Clave de API para acceder a Evolution (la misma que configuras en la UI del CRM)
EVOLUTION_API_KEY=crm-evo-prod-key-2024

# ── Meta / Facebook / Instagram (opcional) ───────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Google Calendar / Meet (opcional) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Zoom (opcional) ───────────────────────────────────────────────────────────
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
